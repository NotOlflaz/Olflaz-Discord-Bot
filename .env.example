# OlflazMC Discord Bot Configuration
# ----------------------------------------------------
# 1. DISCORD_TOKEN: Obtain from Discord Developer Portal -> Your App -> Bot -> Reset Token
DISCORD_TOKEN=your_bot_token_here

# 2. CLIENT_ID: Obtain from Discord Developer Portal -> Your App -> General Information -> Application ID
CLIENT_ID=your_client_id_here

# 3. GUILD_ID: (Recommended) Your Discord Server ID.
# When provided, slash commands update INSTANTLY in your server without waiting up to an hour for global sync.
GUILD_ID=your_guild_id_here

# 4. Optional Channel & Monitoring Overrides (If omitted, resolved dynamically via database / /setup)
# YOUTUBE_CHANNEL_ID=UCl4u_M9jzMV14y-TfrJ0-aQ
# YOUTUBE_ANNOUNCE_CHANNEL_ID=your_new_videos_channel_id
# MOD_LOGS_CHANNEL_ID=your_mod_logs_channel_id
# TICKET_LOGS_CHANNEL_ID=your_ticket_logs_channel_id
# WELCOME_CHANNEL_ID=your_welcome_channel_id
